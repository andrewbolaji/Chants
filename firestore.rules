rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOperator() {
      return isAuth() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/accountDeletionJobs/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'operator'
        && (!('deletionPending' in get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data)
            || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.deletionPending == false);
    }

    function isVisible(res) {
      return res.data.hidden == false && res.data.removed == false;
    }

    function isNotBanned() {
      return exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/accountDeletionJobs/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.banned == false
        && (!('deletionPending' in get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data)
            || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.deletionPending == false);
    }

    // Must match CURRENT_POLICY_VERSION in functions/src/index.ts and
    // kCurrentPolicyVersion in lib/app/policy.dart.
    function hasAcceptedPolicy() {
      return exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.acceptedPolicyVersion == 'v1';
    }

    function isVisibleChant(chantId) {
      return exists(/databases/$(database)/documents/chants/$(chantId))
        && isVisible(get(/databases/$(database)/documents/chants/$(chantId)));
    }

    function isVisibleComment(commentId) {
      return exists(/databases/$(database)/documents/comments/$(commentId))
        && isVisible(get(/databases/$(database)/documents/comments/$(commentId)));
    }

    function hasBlock(blockerId, blockedUserId) {
      return exists(/databases/$(database)/documents/blocks/$(blockerId + '_' + blockedUserId));
    }

    function noBlockBetween(firstUserId, secondUserId) {
      return !hasBlock(firstUserId, secondUserId)
        && !hasBlock(secondUserId, firstUserId);
    }

    function validRecentClientTimestamp(value) {
      return value is timestamp
        && value <= request.time
        && value >= request.time - duration.value(1, 'h');
    }

    function validChantContent(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.lyrics is string
        && data.lyrics.size() > 0
        && data.lyrics.size() <= 5000
        && data.tuneName is string
        && data.tuneName.size() > 0
        && data.tuneName.size() <= 200
        && data.teamId is string
        && data.teamId.size() > 0
        && data.subjectTag in ['player', 'coach', 'club', 'rival']
        && data.chantType in ['sincere', 'novelty']
        && data.mediaType in ['none', 'audio', 'tuneRecording', 'lyricVideo',
                              'screenRecording', 'crowdClip']
        && (data.contextNotes == null ||
            (data.contextNotes is string && data.contextNotes.size() <= 500));
    }

    function hasExactUserChantKeys(data) {
      // Every required field except optional evidence is read below, so a
      // missing key already fails closed. Avoid a duplicate hasAll traversal:
      // author updates otherwise exceed Firestore's expression budget.
      return data.keys().hasOnly([
          'title', 'sportId', 'competitionId', 'teamId', 'playerId',
          'subjectTag', 'lyrics', 'tuneName', 'contextNotes',
          'coverImageUrl', 'mediaUrl', 'mediaType', 'status', 'chantType',
          'origin', 'evidence', 'upvotes', 'downvotes', 'score',
          'commentCount', 'createdBy', 'createdAt', 'updatedAt', 'flagCount',
          'hidden', 'removed', 'variations'
        ]);
    }

    function validNullableString(value) {
      return value == null || value is string;
    }

    function validChantHierarchy(data) {
      return exists(/databases/$(database)/documents/teams/$(data.teamId))
        && get(/databases/$(database)/documents/teams/$(data.teamId)).data.sportId
            == data.sportId
        && get(/databases/$(database)/documents/teams/$(data.teamId)).data.competitionId
            == data.competitionId
        && (
          (data.subjectTag == 'player'
            && data.playerId is string
            && data.playerId.size() > 0
            && exists(/databases/$(database)/documents/players/$(data.playerId))
            && get(/databases/$(database)/documents/players/$(data.playerId)).data.teamId
                == data.teamId)
          ||
          (data.subjectTag != 'player' && data.playerId == null)
        );
    }

    function validUserChantSchema(data) {
      return hasExactUserChantKeys(data)
        && validChantContent(data)
        && data.sportId is string
        && data.sportId.size() > 0
        && data.competitionId is string
        && data.competitionId.size() > 0
        && validNullableString(data.playerId)
        && data.coverImageUrl == null
        && data.mediaUrl == null
        && data.mediaType == 'none'
        && data.status == 'community'
        && data.createdBy is string
        && data.upvotes is int
        && data.downvotes is int
        && data.score is int
        && data.commentCount is int
        && data.flagCount is int
        && data.hidden is bool
        && data.removed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.variations is list
        && data.variations.size() == 0
        && validOrigin(data.origin)
        && validOptionalEvidence(data)
        && validChantHierarchy(data);
    }

    function validOperatorChantSchema(data) {
      return validChantContent(data)
        && data.sportId is string
        && data.competitionId is string
        && (!('playerId' in data) || validNullableString(data.playerId))
        && (!('coverImageUrl' in data) || validNullableString(data.coverImageUrl))
        && (!('mediaUrl' in data) || validNullableString(data.mediaUrl))
        && data.status in ['canonical', 'community']
        && data.createdBy is string
        && data.upvotes is int
        && data.downvotes is int
        && data.score is int
        && data.commentCount is int
        && data.flagCount is int
        && data.hidden is bool
        && data.removed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('variations' in data) || data.variations is list);
    }

    function validOrigin(value) {
      return value in ['alreadySung', 'originalIdea'];
    }

    function hasValidEvidence(data) {
      return 'evidence' in data
        && data.evidence is map
        && data.evidence.keys().hasOnly(['provider', 'url'])
        && data.evidence.provider is string
        && data.evidence.url is string
        && (
          (data.evidence.provider == 'youtube'
            && data.evidence.url.matches(
              'https://www[.]youtube[.]com/watch[?]v=[A-Za-z0-9_-]{11}'))
          ||
          (data.evidence.provider == 'x'
            && data.evidence.url.matches(
              'https://x[.]com/[A-Za-z0-9_]{1,15}/status/[0-9]{1,25}'))
        );
    }

    function validOptionalEvidence(data) {
      return !('evidence' in data)
        || data.evidence == null
        || hasValidEvidence(data);
    }

    function validEvidenceUpdate(before, after) {
      return validOptionalEvidence(after)
        || !after.diff(before).affectedKeys().hasAny(['evidence']);
    }

    function validCanonicalTrustState(before, after) {
      return after.status != 'canonical'
        || before.createdBy == 'system'
        || hasValidEvidence(after)
        || (
          before.status == 'canonical'
          && before.createdBy != 'system'
          && !hasValidEvidence(before)
          && !after.diff(before).affectedKeys().hasAny(['status', 'evidence'])
        );
    }

    function validReplyParent(data) {
      return !('parentCommentId' in data)
        || data.parentCommentId == null
        || (data.parentCommentId is string
            && isVisibleComment(data.parentCommentId)
            && get(/databases/$(database)/documents/comments/$(data.parentCommentId)).data.chantId == data.chantId
            && (!('parentCommentId' in get(/databases/$(database)/documents/comments/$(data.parentCommentId)).data)
                || get(/databases/$(database)/documents/comments/$(data.parentCommentId)).data.parentCommentId == null)
            && noBlockBetween(
                request.auth.uid,
                get(/databases/$(database)/documents/comments/$(data.parentCommentId)).data.userId));
    }

    // sports: public read, operator write
    match /sports/{sportId} {
      allow read: if true;
      allow write: if isOperator();
    }

    // competitions: public read, operator write
    match /competitions/{compId} {
      allow read: if true;
      allow write: if isOperator();
    }

    // teams: public read, operator write
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isOperator();
    }

    // players: public read, operator write
    match /players/{playerId} {
      allow read: if true;
      allow write: if isOperator();
    }

    // profiles: private to the owner and operators, owner create (role, banned, ageConfirmed17Plus,
    // userReportCount pinned; acceptedPolicyVersion/acceptedPolicyAt must be
    // absent, only the acceptPolicy Cloud Function sets them via the Admin
    // SDK), owner update (cannot change role, banned, ageConfirmed17Plus,
    // acceptedPolicyVersion, acceptedPolicyAt, or userReportCount)
    match /profiles/{userId} {
      allow get: if isAuth() && (request.auth.uid == userId || isOperator());
      allow list: if isOperator();
      allow create: if isAuth() && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/accountDeletionJobs/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(
            ['displayName', 'role', 'banned', 'ageConfirmed17Plus',
             'userReportCount', 'createdAt', 'updatedAt'])
        && request.resource.data.role == 'user'
        && request.resource.data.banned == false
        && request.resource.data.ageConfirmed17Plus == true
        && request.resource.data.userReportCount == 0
        && !('acceptedPolicyVersion' in request.resource.data)
        && !('acceptedPolicyAt' in request.resource.data)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 50
        && validRecentClientTimestamp(request.resource.data.createdAt)
        && validRecentClientTimestamp(request.resource.data.updatedAt);
      allow update: if isAuth() && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/accountDeletionJobs/$(request.auth.uid))
        && (!('deletionPending' in resource.data)
            || resource.data.deletionPending == false)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 50
        && validRecentClientTimestamp(request.resource.data.updatedAt);
    }

    // chants: public read (visible only), auth create (not banned, server-side length limits), restricted update
    match /chants/{chantId} {
      allow read: if isVisible(resource) || isOperator();
      allow create: if isAuth()
        && isNotBanned()
        && hasAcceptedPolicy()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.upvotes == 0
        && request.resource.data.downvotes == 0
        && request.resource.data.score == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.flagCount == 0
        && request.resource.data.hidden == false
        && request.resource.data.removed == false
        && validRecentClientTimestamp(request.resource.data.createdAt)
        && validRecentClientTimestamp(request.resource.data.updatedAt)
        && validUserChantSchema(request.resource.data);
      // Authors can edit an explicit content allowlist only while community.
      // Origin and evidence are immutable from the direct client path.
      allow update: if isAuth()
        && isNotBanned()
        && resource.data.createdBy == request.auth.uid
        && resource.data.status == 'community'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'title', 'lyrics', 'tuneName', 'contextNotes', 'subjectTag',
             'chantType', 'playerId', 'updatedAt'
           ])
        && request.resource.data.updatedAt != resource.data.updatedAt
        && validRecentClientTimestamp(request.resource.data.updatedAt)
        && validUserChantSchema(request.resource.data);
      // Operators retain moderation control but cannot mutate ownership or
      // leave a newly promoted or evidence-stripped user chant canonical.
      allow update: if isOperator()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['origin'])
        && validOperatorChantSchema(request.resource.data)
        && validEvidenceUpdate(resource.data, request.resource.data)
        && validCanonicalTrustState(resource.data, request.resource.data);
    }

    // votes: private to the owner/operator, one per user per visible chant
    match /votes/{voteId} {
      // An authenticated transaction may read a missing path before creating
      // it. Existing vote data remains private to its owner or an operator.
      allow get: if isAuth()
        && (!exists(/databases/$(database)/documents/votes/$(voteId))
          || resource.data.userId == request.auth.uid
          || isOperator());
      allow list: if isAuth()
        && (resource.data.userId == request.auth.uid || isOperator());
      allow create: if isAuth()
        && isNotBanned()
        && request.resource.data.keys().hasOnly(
            ['chantId', 'userId', 'value', 'createdAt'])
        && request.resource.data.keys().hasAll(
            ['chantId', 'userId', 'value', 'createdAt'])
        && request.resource.data.chantId is string
        && request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid
        && voteId == request.auth.uid + '_' + request.resource.data.chantId
        && (request.resource.data.value == 1 || request.resource.data.value == -1)
        && validRecentClientTimestamp(request.resource.data.createdAt)
        && isVisibleChant(request.resource.data.chantId);
      allow update: if isAuth()
        && isNotBanned()
        && resource.data.userId == request.auth.uid
        && (request.resource.data.value == 1 || request.resource.data.value == -1)
        && isVisibleChant(resource.data.chantId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['value']);
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Report admission is server-owned so rate budget and report creation can
    // commit atomically. Operators retain the existing read boundary.
    match /reports/{reportId} {
      allow read: if isOperator();
      allow create: if false;
    }

    // auditLog: no client writes (Cloud Functions use Admin SDK), operator read
    match /auditLog/{logId} {
      allow read: if isOperator();
      allow write: if false;
    }

    // comments: visible to all, auth create (not banned, body <= 500),
    // author can soft-delete own (set removed: true), operator can update anything
    match /comments/{commentId} {
      allow read: if isVisible(resource) || isOperator();
      allow create: if isAuth()
        && isNotBanned()
        && hasAcceptedPolicy()
        && request.resource.data.keys().hasOnly([
             'chantId', 'userId', 'displayName', 'body', 'parentCommentId',
             'createdAt', 'likeCount', 'flagCount', 'hidden', 'removed'
           ])
        && request.resource.data.keys().hasAll([
             'chantId', 'userId', 'displayName', 'body', 'createdAt',
             'likeCount', 'flagCount', 'hidden', 'removed'
           ])
        && request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName ==
            get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
        && request.resource.data.displayName.size() > 0
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 500
        && request.resource.data.chantId is string
        && validRecentClientTimestamp(request.resource.data.createdAt)
        && request.resource.data.likeCount == 0
        && request.resource.data.likeCount is int
        && request.resource.data.flagCount == 0
        && request.resource.data.flagCount is int
        && request.resource.data.hidden == false
        && request.resource.data.hidden is bool
        && request.resource.data.removed == false
        && request.resource.data.removed is bool
        && isVisibleChant(request.resource.data.chantId)
        && validReplyParent(request.resource.data);
      // Author can only soft-delete (set removed: true on their own comment)
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && request.resource.data.removed == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removed']);
      // Operator can update anything (moderation: hide, unhide, remove, reset flagCount)
      allow update: if isOperator();
    }

    // commentLikes: private to the owner/operator, one per user per visible comment
    match /commentLikes/{likeId} {
      // An authenticated transaction may read a missing path before creating
      // it. Existing like data remains private to its owner or an operator.
      allow get: if isAuth()
        && (!exists(/databases/$(database)/documents/commentLikes/$(likeId))
          || resource.data.userId == request.auth.uid
          || isOperator());
      allow list: if isAuth()
        && (resource.data.userId == request.auth.uid || isOperator());
      allow create: if isAuth()
        && isNotBanned()
        && request.resource.data.keys().hasOnly(
            ['commentId', 'userId', 'value', 'createdAt'])
        && request.resource.data.keys().hasAll(
            ['commentId', 'userId', 'value', 'createdAt'])
        && request.resource.data.commentId is string
        && request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.commentId
        && request.resource.data.value == 1
        && validRecentClientTimestamp(request.resource.data.createdAt)
        && isVisibleComment(request.resource.data.commentId)
        && noBlockBetween(
            request.auth.uid,
            get(/databases/$(database)/documents/comments/$(request.resource.data.commentId)).data.userId);
      allow update: if isAuth()
        && isNotBanned()
        && resource.data.userId == request.auth.uid
        && request.resource.data.value == 1
        && isVisibleComment(resource.data.commentId)
        && noBlockBetween(
            request.auth.uid,
            get(/databases/$(database)/documents/comments/$(resource.data.commentId)).data.userId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['value']);
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Comment report admission is server-owned. Read behavior is unchanged.
    match /commentReports/{reportId} {
      allow read: if isOperator();
      allow create: if false;
    }

    // User report admission is server-owned. userReportCount on the target
    // profile is recomputed by onUserReportCreated (Admin SDK).
    match /userReports/{reportId} {
      allow read: if isOperator();
      allow create: if false;
    }

    // blocks: directional and private to the blocker. The deterministic ID
    // prevents duplicates; updates are unnecessary because unblock is delete.
    match /blocks/{blockId} {
      allow read: if isAuth() && resource.data.blockerId == request.auth.uid;
      allow create: if isAuth()
        && isNotBanned()
        && request.resource.data.keys().hasOnly(
            ['blockerId', 'blockedUserId', 'blockedDisplayName', 'createdAt'])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId != request.auth.uid
        && request.resource.data.blockedDisplayName is string
        && request.resource.data.blockedDisplayName.size() > 0
        && request.resource.data.blockedDisplayName.size() <= 50
        && request.resource.data.createdAt is timestamp
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUserId
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.blockedUserId));
      allow delete: if isAuth() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    // Feedback admission is server-owned. Owners and operators retain the
    // existing read boundary; all direct client mutations are denied.
    match /feedback/{feedbackId} {
      allow read: if isOperator()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Private server-owned anchored-window counters for safety submissions.
    match /safetyRateLimits/{userId} {
      allow read, write: if false;
    }

    // Private server-owned cursors for retryable account deletion.
    match /accountDeletionJobs/{userId} {
      allow read, write: if false;
    }
  }
}
