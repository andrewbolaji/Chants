{
  "description": "Run the Flutter regression suite before a Codex turn stops.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/run_tests.sh\"",
            "timeout": 300,
            "statusMessage": "Running Flutter regression tests"
          }
        ]
      }
    ]
  }
}
