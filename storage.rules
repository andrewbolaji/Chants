rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedContact() {
      return isSignedIn()
        && (request.auth.token.email_verified == true
          || (request.auth.token.phone_number is string
            && request.auth.token.phone_number.size() > 0)
          || request.auth.token.firebase.sign_in_provider in [
            'apple.com', 'google.com', 'facebook.com'
          ]
          || (request.auth.token.firebase.identities is map
            && request.auth.token.firebase.identities.keys().hasAny([
              'apple.com', 'google.com', 'facebook.com'
            ])));
    }

    function accountIsActive(uid) {
      let profile = firestore.get(
        /databases/(default)/documents/profiles/$(uid)
      );
      return firestore.exists(
          /databases/(default)/documents/profiles/$(uid)
        )
        && profile.data.banned == false
        && profile.data.ageConfirmed17Plus == true
        && profile.data.acceptedPolicyVersion == 'v1'
        && profile.data.deletionPending != true
        && !firestore.exists(
          /databases/(default)/documents/accountDeletionJobs/$(uid)
        );
    }

    function isOperator() {
      return hasVerifiedContact()
        && firestore.get(
          /databases/(default)/documents/profiles/$(request.auth.uid)
        ).data.role == 'operator'
        && accountIsActive(request.auth.uid);
    }

    // Two unique Firestore reads total on the upload path. Account state and
    // the authoritative single upload grant deliberately share one document.
    function ownsUploadTicket(uid, draftId) {
      let control = firestore.get(/databases/(default)/documents/operationalControls/v1).data;
      let profile = firestore.get(/databases/(default)/documents/profiles/$(uid)).data;
      let grant = profile.activePerformanceUpload;
      return control.keys().hasOnly(['schemaVersion', 'generation', 'mode', 'destructiveWorkersEnabled'])
        && control.keys().hasAll(['schemaVersion', 'generation', 'mode', 'destructiveWorkersEnabled'])
        && control.schemaVersion == 1
        && control.generation is int && control.generation >= 1 && control.generation <= 9007199254740991
        && control.mode == 'media' && control.destructiveWorkersEnabled == true
        && profile.banned == false && profile.ageConfirmed17Plus == true
        && profile.acceptedPolicyVersion == 'v1' && profile.deletionPending == false
        && grant is map
        && grant.keys().hasOnly(['schemaVersion', 'draftId', 'ownerId', 'uploadPath',
          'sizeBytes', 'contentType', 'generation', 'issuedAt', 'expiresAt'])
        && grant.keys().hasAll(['schemaVersion', 'draftId', 'ownerId', 'uploadPath',
          'sizeBytes', 'contentType', 'generation', 'issuedAt', 'expiresAt'])
        && grant.schemaVersion == 1 && grant.draftId == draftId && grant.ownerId == uid
        && grant.generation == control.generation
        && grant.issuedAt is timestamp && grant.expiresAt is timestamp
        && grant.issuedAt <= request.time && grant.expiresAt > request.time
        && grant.expiresAt == grant.issuedAt + duration.value(30, 'm')
        && grant.uploadPath == 'performance-staging/' + uid + '/' + draftId + '/source'
        && grant.sizeBytes is int && grant.sizeBytes == request.resource.size
        && grant.contentType == request.resource.contentType;
    }

    // A callable creates a single-use ticket before the client uploads. The
    // path, byte count, MIME type, owner, and custom metadata must all agree
    // with that server-owned account grant. Direct replacement and deletion are off.
    match /performance-staging/{uid}/{draftId}/source {
      allow create: if isSignedIn()
        && hasVerifiedContact()
        && request.auth.uid == uid
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType in [
          'video/mp4', 'video/quicktime', 'video/x-m4v'
        ]
        && request.resource.metadata.keys().hasOnly([
          'ownerId', 'draftId', 'schemaVersion'
        ])
        && request.resource.metadata.ownerId == uid
        && request.resource.metadata.draftId == draftId
        && request.resource.metadata.schemaVersion == '1'
        && ownsUploadTicket(uid, draftId);
      allow read: if isSignedIn()
        && (request.auth.uid == uid || isOperator());
      allow update, delete: if false;
    }

    // Approved playback uses a short-lived URL minted only after a fresh
    // server check of the performance projection. Firebase client reads stay
    // closed so cached feed data cannot authorize playback after moderation.
    match /performance-media/{performanceId}/source {
      allow read, write: if false;
    }

    // Deny everything outside the explicitly ticketed paths.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
